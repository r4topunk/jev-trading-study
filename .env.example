# The only credential: a Vercel AI Gateway key (https://vercel.com/docs/ai-gateway). Export it in your shell, never commit it.
# VERCEL_AI_GATEWAY=

# The public Base RPC works (2,000-block getLogs cap, rate limited). A dedicated one makes the backfill faster.
BASE_RPC_URL=https://mainnet.base.org
RPC_CONCURRENCY=2
JEV_CONCURRENCY=6

# Optional, arb/ only: resolve hostnames through these DNS servers instead of the system resolver.
# ARB_DNS=1.1.1.1,8.8.8.8
